---
import Base from './Base.astro';
import PartyBadge from '../components/PartyBadge.astro';

interface Props {
  title: string;
  summary: string;
  date: Date;
  party: 'D' | 'R';
  state: string;
  chamber: 'House' | 'Senate';
  tags: string[];
  sources: { url: string; label: string }[];
}

const { title, summary, date, party, state, chamber, tags, sources } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={title} description={summary}>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <div class="mb-6">
      <div class="flex items-center gap-3 mb-4">
        <PartyBadge party={party} />
        <span class="text-sm text-gray-500">{chamber} · {state} · {formattedDate}</span>
      </div>
      <h1 class="text-3xl font-bold text-navy leading-tight mb-4">{title}</h1>
      <p class="text-lg text-gray-600 border-l-4 border-civic-red pl-4">{summary}</p>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {tags.map(tag => (
          <span class="text-xs font-medium bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <div class="prose prose-lg max-w-none prose-headings:text-navy prose-a:text-civic-red">
      <slot />
    </div>

    {sources.length > 0 && (
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-lg font-bold text-navy mb-4">Sources</h2>
        <ul class="space-y-2">
          {sources.map(source => (
            <li class="text-sm">
              <a href={source.url} target="_blank" rel="noopener noreferrer"
                 class="text-civic-red hover:underline">
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-8">
      <a href="/blog" class="text-sm font-medium text-navy hover:text-civic-red transition-colors">
        ← Back to all posts
      </a>
    </div>
  </article>
</Base>
