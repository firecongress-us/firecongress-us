---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const filter = Astro.url.searchParams.get('party') ?? 'all';
const filtered = filter === 'all' ? allPosts : allPosts.filter(p => p.data.party === filter);
---

<Base title="Accountability Reports" description="Documented, sourced reports on members of Congress from both parties.">
  <div class="bg-navy text-white py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-black mb-2">Accountability Reports</h1>
      <p class="text-gray-300">Every report is documented and sourced. Equal coverage of both parties.</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex gap-2 mb-8">
      {[
        { value: 'all', label: `All (${allPosts.length})` },
        { value: 'D', label: `Democrat (${allPosts.filter(p => p.data.party === 'D').length})` },
        { value: 'R', label: `Republican (${allPosts.filter(p => p.data.party === 'R').length})` },
      ].map(tab => (
        <a
          href={tab.value === 'all' ? '/blog' : `/blog?party=${tab.value}`}
          class={`px-4 py-2 rounded text-sm font-medium transition-colors ${
            filter === tab.value
              ? 'bg-navy text-white'
              : 'bg-white text-gray-600 border border-gray-200 hover:border-navy hover:text-navy'
          }`}
        >
          {tab.label}
        </a>
      ))}
    </div>

    {filtered.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6">
        {filtered.map(post => (
          <PostCard
            title={post.data.title}
            summary={post.data.summary}
            date={post.data.date}
            party={post.data.party}
            state={post.data.state}
            chamber={post.data.chamber}
            slug={post.id}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-gray-400">
        <p class="text-lg font-medium mb-2">No reports yet.</p>
        <p class="text-sm">Check back soon — research is underway.</p>
      </div>
    )}
  </div>
</Base>
